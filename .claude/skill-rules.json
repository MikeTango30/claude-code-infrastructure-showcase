{
  "$schema": "https://anthropic.com/claude-code/skill-rules-schema.json",
  "version": "1.0",
  "skills": [
    {
      "name": "hyva-themes",
      "description": "Hyvä Themes development (Alpine.js, Tailwind CSS, ViewModels, Hyvä Checkout)",
      "triggers": {
        "keywords": [
          "hyva",
          "hyvä",
          "hyva themes",
          "alpine",
          "alpine.js",
          "alpinejs",
          "tailwind",
          "tailwind css",
          "tailwindcss",
          "viewmodel",
          "view model",
          "hyva checkout",
          "hyvä checkout",
          "magewire",
          "compatibility module",
          "x-data",
          "x-init",
          "x-show",
          "x-if",
          "x-for",
          "@click",
          "reactive component",
          "alpine component",
          "tailwind component",
          "tailwind.config.js",
          "phtml alpine",
          "knockout to alpine",
          "requirejs to alpine",
          "convert to hyva",
          "hyva compatible",
          "purge css",
          "jit compilation"
        ],
        "file_patterns": [
          "**/*hyva*/templates/**/*.phtml",
          "**/tailwind/components/**/*.css",
          "**/tailwind.config.js",
          "**/ViewModel/**/*.php",
          "**/*Hyva*/**/*.php",
          "**/view/frontend/templates/**/*.phtml"
        ],
        "intent_patterns": [
          "create.*hyva.*component",
          "create.*alpine.*component",
          "hyva.*compatibility",
          "convert.*to.*hyva",
          "alpine.*tailwind",
          "viewmodel.*data",
          "hyva.*checkout",
          "magewire.*component",
          "reactive.*component",
          "tailwind.*styling"
        ],
        "content_patterns": [
          "x-data=",
          "x-init=",
          "@click=",
          "x-show=",
          "x-model=",
          "ArgumentInterface",
          "ViewModelRegistry",
          "@apply",
          "@layer components",
          "initHyva",
          "Alpine\\.\\$data"
        ]
      },
      "priority": "high",
      "auto_activate": true
    },
    {
      "name": "magento2-dev-guidelines",
      "description": "Magento 2 development patterns and best practices",
      "triggers": {
        "keywords": [
          "magento",
          "magento 2",
          "magento2",
          "m2",
          "adobe commerce",
          "module",
          "plugin",
          "observer",
          "preference",
          "di.xml",
          "dependency injection",
          "repository pattern",
          "service contract",
          "interceptor",
          "event observer",
          "db_schema.xml",
          "etc/module.xml",
          "registration.php",
          "setup patch",
          "declarative schema",
          "web api",
          "rest api",
          "graphql",
          "ui component",
          "layout xml",
          "block class",
          "phtml template",
          "composer.json magento",
          "bin/magento",
          "setup:upgrade",
          "setup:di:compile"
        ],
        "file_patterns": [
          "app/code/**/*.php",
          "**/etc/di.xml",
          "**/etc/module.xml",
          "**/etc/db_schema.xml",
          "**/etc/events.xml",
          "**/etc/webapi.xml",
          "**/etc/acl.xml",
          "**/etc/config.xml",
          "**/etc/adminhtml/system.xml",
          "**/registration.php",
          "**/Setup/Patch/**/*.php",
          "**/Plugin/**/*.php",
          "**/Observer/**/*.php",
          "**/Model/ResourceModel/**/*.php",
          "**/Api/**/*.php"
        ],
        "intent_patterns": [
          "create.*magento.*module",
          "magento.*plugin",
          "magento.*observer",
          "dependency injection.*magento",
          "service contract",
          "repository pattern.*magento",
          "setup.*patch",
          "declarative schema",
          "intercept.*method",
          "event.*observer",
          "preference.*interface",
          "virtual type",
          "magento.*api",
          "rest.*endpoint",
          "admin.*configuration",
          "system.*xml",
          "acl.*resource",
          "database.*schema.*magento"
        ],
        "content_patterns": [
          "use Magento\\\\",
          "ComponentRegistrar::register",
          "\\bObserverInterface\\b",
          "\\bRepositoryInterface\\b",
          "<config.*module\\.xsd",
          "<config.*di\\.xsd",
          "<config.*db_schema\\.xsd",
          "public function before[A-Z]",
          "public function after[A-Z]",
          "public function around[A-Z]",
          "implements ObserverInterface",
          "extends AbstractModel"
        ]
      },
      "priority": "high",
      "auto_activate": true
    },
    {
      "name": "tdd-workflow",
      "description": "Test-Driven Development workflow for autonomous implementation",
      "triggers": {
        "keywords": [
          "tdd",
          "test driven",
          "write tests first",
          "red green refactor",
          "phpunit",
          "unit test",
          "going afk",
          "i'm afk",
          "implement until tests pass",
          "autonomous",
          "self-correcting"
        ],
        "file_patterns": [
          "**/Test/Unit/**/*.php",
          "**/Test/Integration/**/*.php",
          "**/*Test.php",
          "**/phpunit.xml",
          "**/phpunit.xml.dist"
        ],
        "intent_patterns": [
          "write.*test.*first",
          "tdd.*approach",
          "test.*driven",
          "going.*afk.*implement",
          "implement.*until.*test.*pass",
          "run.*test.*implement",
          "autonomous.*implementation",
          "test.*red.*implement"
        ],
        "content_patterns": [
          "extends TestCase",
          "extends \\\\PHPUnit",
          "public function test[A-Z]",
          "\\$this->assert",
          "\\$this->expect",
          "@test",
          "setUp\\(\\)",
          "tearDown\\(\\)"
        ]
      },
      "priority": "high",
      "auto_activate": false
    },
    {
      "name": "doc-driven-workflow",
      "description": "Documentation-Driven Phase Workflow for token efficiency",
      "triggers": {
        "keywords": [
          "documentation driven",
          "phase workflow",
          "phase execution",
          "fresh context",
          "token efficiency",
          "phase isolation",
          "plan.md",
          "design.md",
          "phase-exec"
        ],
        "file_patterns": [
          "documentation/features/**/plan.md",
          "documentation/features/**/design.md",
          "documentation/features/**/tasks.md",
          "documentation/features/**/architecture.md",
          "documentation/features/**/requirements.md",
          "documentation/modules/**/*.md"
        ],
        "intent_patterns": [
          "break.*into.*phase",
          "phase.*based.*approach",
          "fresh.*context.*per.*phase",
          "execute.*phase",
          "documentation.*driven",
          "token.*efficiency",
          "phase.*isolation",
          "checkpoint.*phase"
        ]
      },
      "priority": "medium",
      "auto_activate": false
    },
    {
