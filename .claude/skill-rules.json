  ],
  "rules": {
    "max_active_skills": 3,
    "conflict_resolution": "priority",
    "activation_mode": "explicit_and_auto"
  },
  "patterns": {
    "hyva_component_creation": {
      "description": "Detect when user wants to create Hyvä/Alpine.js component",
      "activate_skills": ["hyva-themes"],
      "suggest_commands": ["/hyva-component", "/hyva-module"],
      "patterns": [
        "create.*hyva.*component",
        "create.*alpine.*component",
        "new.*hyva.*component",
        "scaffold.*alpine",
        "hyva.*compatibility.*module",
        "viewmodel.*component"
      ]
    },
    "magento2_module_creation": {
      "description": "Detect when user wants to create a Magento 2 module",
      "activate_skills": ["magento2-dev-guidelines"],
      "suggest_commands": ["/m2-module"],
      "patterns": [
        "create.*magento.*module",
        "new.*magento.*module",
        "scaffold.*module",
        "generate.*module.*magento"
      ]
    },
    "tdd_implementation": {
      "description": "Detect TDD workflow initiation",
      "activate_skills": ["tdd-workflow"],
      "patterns": [
        "write.*test.*first",
        "going.*afk.*implement",
        "tdd.*approach",
        "implement.*until.*test.*pass"
      ]
    },
    "phase_based_development": {
      "description": "Detect documentation-driven phase workflow",
      "activate_skills": ["doc-driven-workflow"],
      "suggest_commands": ["/feature", "/clarify", "/research", "/phase-exec"],
      "patterns": [
        "break.*into.*phase",
        "fresh.*context",
        "phase.*execution",
        "documentation.*driven"
      ]
    },
    "magento2_tdd_combined": {
      "description": "Detect combined Magento 2 + TDD workflow",
      "activate_skills": ["magento2-dev-guidelines", "tdd-workflow"],
      "patterns": [
        "magento.*test.*first",
        "magento.*tdd",
        "phpunit.*magento.*module"
      ]
    }
  },
  "suggestions": {
    "on_module_creation": {
      "condition": "file_created:app/code/**/**/registration.php",
      "message": "✅ Module created! Next steps:\n  • For TDD: Write tests in Test/Unit/, then 'I'm going AFK'\n  • For Phases: Run /feature [name] to break into phases\n  • For Quick: Describe what to implement"
    },
    "on_test_file_created": {
      "condition": "file_created:**/*Test.php",
      "message": "✅ Tests created! Use TDD workflow:\n  • Say: 'I'm going AFK, implement until tests pass'\n  • Claude will autonomously implement with test-driven approach"
    },
    "on_feature_docs_created": {
      "condition": "directory_created:documentation/features/**",
      "message": "✅ Feature docs created! Next:\n  • /clarify [feature-name] - Ask clarifying questions\n  • /research [feature-name] - Analyze codebase\n  • /phase-exec [feature-name] 1 - Start Phase 1 with fresh context"
    }
  }
}
